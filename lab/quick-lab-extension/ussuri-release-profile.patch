+#!/usr/bin/env bash
+# Runs on the lab VM, after "Install Kolla-Ansible" and before "pull" (profile ussuri only).
+# Kolla Ussuri images are not pullable (Docker Hub kolla/* answers 401, quay.io has no Ussuri tags used here), so build
+# them with kolla-build 10.4.0 into a local registry and let Kolla-Ansible pull from it.
+# PROPOSED-UNVERIFIED. The 2026-10-31 probe (lab/ussuri-db-lab/kolla-probe) built `base` only, and only after removing the
+# Cloud Archive / apt-key / custom-repo steps; see the journey assessment 05 for what was and was not reachable.
+set -euo pipefail
+VENV=~/kolla-venv; REG=${DOCKER_REGISTRY:-127.0.0.1:4000}; TAG=${OPENSTACK_TAG:-ussuri}
+UC=~/upper-constraints-ussuri-eol.txt
+# upper-constraints of the series (pins Jinja2<3.1: kolla 10 imports jinja2.contextfilter, removed in Jinja2 3.1)
+[ -f "$UC" ] || curl -fsSL "https://opendev.org/openstack/requirements/raw/tag/ussuri-eol/upper-constraints.txt" -o "$UC" \
+  || git archive --remote=https://opendev.org/openstack/requirements ussuri-eol upper-constraints.txt | tar -x -O > "$UC"
+"$VENV/bin/pip" install -q -c "$UC" kolla==10.4.0
+docker ps --format '{{.Names}}' | grep -qx ussuri-registry || docker run -d --restart unless-stopped --name ussuri-registry -p 127.0.0.1:4000:5000 registry:2
+cat > ~/kolla-build.conf <<CONF
+[DEFAULT]
+base = ubuntu
+base_tag = 18.04
+install_type = source
+namespace = kolla
+registry = $REG
+tag = $TAG
+push = true
+# Source: tarballs.opendev.org is the Kolla default; use git at the series tag when it is not reachable.
+[openstack-base]
+type = git
+location = https://opendev.org/openstack/requirements
+reference = ussuri-eol
+CONF
+# one-node lab image set (profile subset): keep it small
+"$VENV/bin/kolla-build" --config-file ~/kolla-build.conf "^(keystone|glance-api|nova-(api|conductor|scheduler|compute|libvirt|ssh|novncproxy)|neutron-(server|openvswitch-agent|dhcp-agent|l3-agent|metadata-agent)|openvswitch-(db-server|vswitchd)|placement-api|horizon|mariadb|rabbitmq|memcached|keepalived|haproxy|cron|fluentd|kolla-toolbox|chrony)$"
