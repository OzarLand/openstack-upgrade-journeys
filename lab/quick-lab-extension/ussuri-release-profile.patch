+HAS_USE_TEST_IMAGES="${HAS_USE_TEST_IMAGES:-yes}"; OLD_SYSTEMD="${OLD_SYSTEMD:-no}"; APT_SOURCES_FORMAT="${APT_SOURCES_FORMAT:-deb822}"; PIP_EXTRA="${PIP_EXTRA:-docker dbus-python}"; HAS_DOCKER_PROXY_VARS="${HAS_DOCKER_PROXY_VARS:-yes}"
