+ANSIBLE_PIP_SPEC="${ANSIBLE_PIP_SPEC:-ansible-core==$ANSIBLE_CORE_VERSION}"; KOLLA_BASE_DISTRO="${KOLLA_BASE_DISTRO:-ubuntu}"; KOLLA_INSTALL_TYPE="${KOLLA_INSTALL_TYPE:-}"
