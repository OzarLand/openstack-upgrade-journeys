+# Release profile: OpenStack Ussuri (2020.1, end of life) with Kolla-Ansible 10.x.
+# PROPOSED-UNVERIFIED: written from the upstream sources (kolla-ansible@ussuri-eol), never run on a cloud.
+# Load by setting RELEASE_PROFILE="ussuri" in config.env. Values below override the 2026.1 defaults.
+
+# Kolla-Ansible 10.x supports Ansible 2.8 to 2.9 only (ansible/roles/prechecks/vars/main.yml). 'ansible-core' does not
+# exist for 2.9: the package is 'ansible'.
+KOLLA_ANSIBLE_VERSION="10.4.0"
+ANSIBLE_PIP_SPEC="ansible>=2.9,<2.10"
+# Host OS: Ubuntu 18.04 (bionic) or CentOS 8, Debian 10, RHEL 8 (doc/source/user/support-matrix.rst). This lab driver
+# knows Ubuntu only. All of these are end of life: use an image you build and keep, or an ESM-enabled one.
+HOST_IMAGE_REGEX='ubuntu.*18\.04'
+# Kolla image selection (ansible/group_vars/all.yml: docker_namespace=kolla, kolla_install_type default "binary")
+KOLLA_BASE_DISTRO="ubuntu"
+KOLLA_INSTALL_TYPE="source"
+OPENSTACK_RELEASE_TAG="ussuri"
+# The kolla/* images on Docker Hub are not pullable anonymously (HTTP 401, tags 'inactive'): a registry is REQUIRED,
+# either one you pushed images to, or the output of scripts/kolla-build-ussuri.sh pushed to a local registry.
+REQUIRE_DOCKER_REGISTRY="yes"
+# Kolla-Ansible 10.x has no 'install-deps' command, no kolla_container_engine, no ProxySQL, and no --use-test-images.
+HAS_INSTALL_DEPS="no"
+HAS_CONTAINER_ENGINE_VAR="no"
+HAS_PROXYSQL="no"
+HAS_USE_TEST_IMAGES="no"
+# systemd 237 (Ubuntu 18.04) has neither 'networkctl reload' nor 'timedatectl show'.
+OLD_SYSTEMD="yes"
+# /etc/apt/sources.list (one-line format) instead of /etc/apt/sources.list.d/ubuntu.sources (deb822)
+APT_SOURCES_FORMAT="list"
+# Packages: dbus-python is only needed by newer Kolla-Ansible; 'docker' SDK must be < 5 for Ansible 2.9 modules.
+PIP_EXTRA="docker<5"
+
+# docker_http_proxy & co. do not exist in Kolla-Ansible 10.x (added later): remote-deploy.sh writes a systemd drop-in instead.
+HAS_DOCKER_PROXY_VARS="no"
+IMAGE_SOURCE="build"   # or "registry" when DOCKER_REGISTRY already holds kolla/ubuntu-source-*:ussuri
